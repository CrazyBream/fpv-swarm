{
  "name": "fpv-swarm",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "node --env-file=.env --watch server/src/index.js",
    "dev:client": "npm --workspace=client run dev",
    "build": "npm --workspace=client run build",
    "start": "node --env-file=.env server/src/index.js",
    "test": "node --test server/test/protocol.test.js",
    "lint": "biome check ./shared/src ./client/src ./server/src ./server/test",
    "format": "biome format --write ./shared/src ./client/src ./server/src ./server/test"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "vite": "^6.2.0"
  }
}