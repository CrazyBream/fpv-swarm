{
  "name": "fpv-swarm",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "tsx watch --env-file=.env server/src/index.ts",
    "dev:client": "npm --workspace=client run dev",
    "build": "npm run typecheck && npm --workspace=client run build",
    "start": "tsx --env-file=.env server/src/index.ts",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "loadtest": "tsx server/src/loadtest.ts",
    "lint": "biome check ./shared/src ./client/src ./server/src ./shared/test ./client/test ./server/test",
    "format": "biome format --write ./shared/src ./client/src ./server/src ./shared/test ./client/test ./server/test"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^3.0.7",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}